# Deployment URL (e.g., https://your-app.vercel.app)
NEXT_PUBLIC_VERCEL_URL=

# Supabase configuration (run `npm run db:status` for the local values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Circle API configuration (https://console.circle.com/apikeys)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# ===== Circle Onramp (Fund Wallet) =====
#
# The "Fund Wallet" button opens Circle's onramp widget embedded over the phone
# screen, buying USDC straight into the user's Arc wallet. Two independent URLs
# select the environment — the API base URL (server) and the widget origin
# (both halves) — and the app refuses to start if they disagree.

# The onramp uses CIRCLE_API_KEY above. A key is bound to one environment, so a
# TEST_API_KEY must be paired with the sandbox URLs below.

# Sandbox endpoints. Keep these set unless you intend to move real money:
# removing them targets Circle's production API and widget on mainnet.
# Set both together — the app refuses to start if they disagree.
#
# Sandbox is also the environment that matches the rest of this app: the widget
# resolves `arc` to Arc Testnet here, which is the same chain ARC_CHAIN_ID
# 5042002 pins the webhook handler and /api/wallet to.
ONRAMP_API_BASE_URL=https://api-test.circle.com
NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# The widget is embedded in the phone screen by default. Uncomment to open the
# hosted experience in a popup window instead. Read at build time, so restart
# `npm run dev` after changing it.
#
# Embedding works on sandbox only: the production widget refuses to be framed by
# an origin Circle has not registered, so the app detects production and opens
# the popup automatically, whatever this is set to.
# NEXT_PUBLIC_ONRAMP_POPUP=1
